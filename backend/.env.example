NODE_ENV=development
PORT=3001
# Local MongoDB; the admin user authenticates against the admin database.
MONGODB_URI=mongodb://admin:123456@localhost:27017/fitflow?authSource=admin
# Google OAuth client IDs (comma-separated) accepted as ID token audience.
GOOGLE_CLIENT_IDS=578747595727-nftl7og0f8q21va0hdhohd6subqn2iiv.apps.googleusercontent.com
# Access-token signing secret (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-48-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
