@startuml fitflow-use-cases
title FitFlow — Use cases
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFEDFB
  BorderColor #6558D3
}
actor "Guest" as guest
actor "User" as user
actor "Admin" as admin
actor "Google Sign-In" as google <<system>>
rectangle "FitFlow" {
  usecase "Sign in with email & password" as a3
  usecase "Sign in with Google" as a1
  usecase "//Authenticate//" as au
  usecase "Browse workout library" as m3
  usecase "Plan weekly schedule" as m2
  usecase "Do a guided workout" as m4
  usecase "Check exercise form" as m5
  usecase "Plan nutrition & meals" as m6
  usecase "Log a meal" as m7
  usecase "Track body weight & profile" as m8
  usecase "View progress & records" as m9
  usecase "View session history" as m10
  usecase "Sign out" as a2
  usecase "View statistics dashboard" as d1
  usecase "Monitor AI usage" as d2
  usecase "Manage users" as d3
  usecase "Manage workout templates" as d4
}
guest -- a3
guest -- a1
user -- m3
user -- m2
user -- m4
user -- m5
user -- m6
user -- m7
user -- m8
user -- m9
user -- m10
user -- a2
admin -- a2
admin -- d1
admin -- d2
admin -- d3
admin -- d4
a3 --|> au
a1 --|> au
a1 -- google
@enduml
