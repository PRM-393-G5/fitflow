@startuml fitflow-usecase-overview
title FitFlow — Use cases (overview)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFEDFB
  BorderColor #6558D3
}
actor "User\n(trainee)" as user
actor "Admin" as admin
actor "Google\nSign-In" as google <<system>>
actor "Camera +\nML Kit Pose" as camera <<system>>
actor "OpenAI\n(GPT models)" as openai <<system>>
actor "Device OS\n(notifications, share)" as os <<system>>
rectangle "FitFlow system" {
  package "Mobile app (Flutter) + FitFlow API" {
    usecase "Sign in with Google" as o1
    usecase "Plan workouts" as o2
    usecase "Do a guided workout" as o3
    usecase "Check exercise form" as o4
    usecase "Get AI coaching" as o5
    usecase "Plan nutrition & log meals" as o6
    usecase "Track progress & body metrics" as o7
    usecase "Manage settings & reminders" as o8
    usecase "Back up & sync data" as o9
  }
  package "Admin web (React) + admin API" {
    usecase "Sign in (email & password)" as a1
    usecase "View statistics dashboard" as a2
    usecase "Manage users" as a3
    usecase "Manage workout templates" as a4
    usecase "Monitor AI usage" as a5
  }
}
user -- o1
user -- o2
user -- o3
user -- o4
user -- o5
user -- o6
user -- o7
user -- o8
user -- o9
admin -- a1
admin -- a2
admin -- a3
admin -- a4
admin -- a5
o1 -- google
o4 -- camera
o5 -- openai
o6 -- openai
o8 -- os
@enduml

@startuml fitflow-usecase-account-data
title FitFlow — Account & data
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFEDFB
  BorderColor #6558D3
}
actor "User" as user
actor "Google\nSign-In" as google <<system>>
rectangle "Mobile app + FitFlow API" {
  usecase "Sign in with Google" as s1
  usecase "Sign out" as s2
  usecase "Delete account" as s3
  usecase "Back up data (JSON)" as s4
  usecase "See “account locked” message" as s7
  usecase "Sync data with the cloud" as s5
  usecase "Re-authenticate with Google" as s6
  usecase "Export data" as s8
  usecase "Import data" as s9
}
user -- s1
user -- s2
user -- s3
user -- s4
s1 -- google
s6 -- google
s1 ..> s5 : <<include>>\ndownload account data
s2 ..> s5 : <<include>>\nupload pending changes
s3 ..> s6 : <<include>>
s7 ..> s1 : <<extend>>\n[locked by an admin]
s8 --|> s4
s9 --|> s4
note as n1
  Sign-in is required. Data stays cached on the phone, so it works offline; edits wait in an outbox until they reach the server.
end note
@enduml

