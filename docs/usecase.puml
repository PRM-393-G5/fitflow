@startuml fitflow-usecase-admin-web
title FitFlow — Admin web
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFEDFB
  BorderColor #6558D3
}
actor "Admin" as admin
rectangle "Admin web (React) + admin API" {
  usecase "Sign in (email & password)" as d0
  usecase "View statistics dashboard" as d1
  usecase "Monitor AI usage" as d2
  usecase "Manage users" as m1
  usecase "Manage workout templates" as t0
  usecase "View chart as table" as d4
  usecase "Choose date range" as d3
  usecase "Search & filter users" as m2
  usecase "View user details" as m3
  usecase "Lock / unlock account" as m4
  usecase "Delete account & data" as m5
  usecase "Confirm by typing the email" as m6
  usecase "Create template" as t1
  usecase "Edit template" as t2
  usecase "Reorder templates" as t3
  usecase "Delete template" as t4
}
admin -- d0
admin -- d1
admin -- d2
admin -- m1
admin -- t0
d4 ..> d1 : <<extend>>
d1 ..> d3 : <<include>>
d2 ..> d3 : <<include>>
m1 ..> m2 : <<include>>
m3 ..> m1 : <<extend>>
m4 ..> m3 : <<extend>>
m5 ..> m3 : <<extend>>
m5 ..> m6 : <<include>>
t1 --|> t0
t2 --|> t0
t3 --|> t0
t4 --|> t0
note as n1
  Every admin use case needs a signed-in admin. Locking signs the user out everywhere and blocks sign-in, sync and AI.
end note
@enduml
